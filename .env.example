# Postgres connection string used by SQLAlchemy
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_db

# Comma-separated list of origins allowed to call this API (no trailing slashes)
CORS_ORIGINS=http://localhost:5173

# Directory (relative to the process working directory, or absolute) where
# uploaded compliance documents are stored
UPLOAD_DIR=uploads/documents

# Secret used to sign JWT access tokens - generate a unique one per environment,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=change-me-to-a-random-value

# How long an issued access token stays valid
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Whether to auto-seed demo/sample business data (default registries, sample
# policy documents) on first request. Leave False in staging/production.
ENABLE_DEMO_SEED=False
