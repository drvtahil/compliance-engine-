# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# URL path prefix each app is served under. Leave both as shown below for
# local dev (Super Admin at "/", Account Portal at "/account"). In
# production set e.g. VITE_ADMIN_BASE_PATH=/admin and
# VITE_ACCOUNT_BASE_PATH=/compliance to serve both from one domain.
VITE_ADMIN_BASE_PATH=
VITE_ACCOUNT_BASE_PATH=/account
